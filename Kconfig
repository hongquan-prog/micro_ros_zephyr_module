# PWM/DDS demo application Kconfig.
#
# When an application provides its own Kconfig it becomes the Kconfig root,
# so the Zephyr core tree must be sourced explicitly.

mainmenu "PWM/DDS demo"

source "Kconfig.zephyr"

menu "PWM/DDS demo"

config DEMO_HEARTBEAT_STUB
	bool "Stub heartbeat backend (simulated Linux round trip)"
	default n
	help
	  Use the stub backend instead of the real micro-ROS DDS link.
	  Enable at build time with -DHEARTBEAT_STUB=y.

config DEMO_HEARTBEAT_MICROROS
	bool
	default y if !DEMO_HEARTBEAT_STUB
	select MICROROS
	select CPP
	select POSIX_API

config DEMO_SHELL
	bool "Demo shell (dds diagnostics + hb tuning)"
	default y
	help
	  Enable the demo shell command sets:
	  - "dds" diagnostics (status/stats/shm) for the heartbeat link;
	  - "hb" business tuning (period/freq) for the signal chain.
	  Requires CONFIG_SHELL=y (see prj.conf).

config DEMO_CONTROL_PERIOD_MS
	int "Signal-chain control period default (ms)"
	default 50
	range 1 1000
	help
	  Default control period of the signal chain (GPIO/PWM/heartbeat
	  cadence).  TEMPORARY debugging value: 50 ms while the DDS link
	  is being brought up; restore to 1 ms afterwards.  Can be
	  overridden at runtime with "hb period <ms>" / "hb freq <hz>".

config DEMO_RK_TIMER
	bool "Use the RK3588 bus timer for the control tick (hard real-time)"
	default n
	help
	  Drive the signal chain tick from the RK3588 bus timer (timer0)
	  counter driver instead of the systick k_timer.  The hardware
	  auto-reload fires the 1 ms callback with no software re-arm
	  jitter, and supports sub-millisecond periods (hb period accepts
	  them; the systick path is limited to >= 1 ms).

	  Requires the rockchip counter driver and the timer0 devicetree
	  node in the Zephyr tree (commits on wip/hongquan.li/
	  ProcessONE-RTOS-Demo, archived at gerrit wip/libryan/pwm-rk3588).
	  Default n so builds against Zephyr trees without the driver keep
	  working.

endmenu
